# API Configuration
# BYOK: "true" to use your own API key, "false" to use default API
API_BYOK=false
API_URL=https://818233.xyz
API_KEY=your-api-key-here

# Directory Configuration
# Startup: Parent directory for project sessions (Windows format supported)
DIRECTORY_STARTUP=./projects

# Program Log Configuration
# Program log: Application startup and runtime errors
PROGRAM_LOG_NAME=free-agent.log
PROGRAM_LOG_LEVEL=info
